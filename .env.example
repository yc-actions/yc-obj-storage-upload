# Inputs for `npm run local-action`. Copy to .env and fill in.
# GitHub Actions passes inputs as INPUT_<NAME> with dashes preserved.

# Credentials - set exactly one of the three.
INPUT_YC-SA-JSON-CREDENTIALS=
INPUT_YC-IAM-TOKEN=
INPUT_YC-SA-ID=

# Required.
INPUT_BUCKET=
INPUT_ROOT=.

# Source selection.
INPUT_INCLUDE=*
INPUT_EXCLUDE=
INPUT_PREFIX=

# Behavior.
INPUT_CLEAR=false
INPUT_CACHE-CONTROL=
INPUT_CONCURRENCY=16
INPUT_SKIP-UNCHANGED=false
INPUT_FAIL-ON-ERROR=false

# Runner context the action reads directly.
GITHUB_WORKSPACE=.
